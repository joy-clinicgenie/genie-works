# Clinic Genie environment variable names. Copy to .env and fill locally. Never commit real values.

# --- Database (PostgreSQL) ---
# Admin connection used by migrations, seeds, backups and restore tests.
DATABASE_ADMIN_URL=postgresql://postgres:postgres@127.0.0.1:54339/clinic_genie
# Application connection used by the apps. Role cg_app has row-level security applied.
DATABASE_URL=postgresql://cg_app:cg_app_dev@127.0.0.1:54339/clinic_genie
# Password set on the cg_app role when migrations run. Change for staging/production.
APP_DB_PASSWORD=cg_app_dev
# Embedded development database settings (npm run db:start).
EMBEDDED_PG_PORT=54339
EMBEDDED_PG_DIR=.data/postgres
# Refuses seeds, resets and restore tests unless the target database name contains this marker.
# Those commands also refuse a remote host, production, and port 54329.
SEED_ALLOWED_DB_PATTERN=clinic_genie
# Backup and restore-test refuse a database whose name does not contain this marker.
# Unset means rehearsal. This does not allow a remote host or production.
RECOVERY_ALLOWED_DB_PATTERN=rehearsal

# --- Clinic Genie platform (apps/platform) ---
# Runtime secret for sessions. Replace the placeholder. The build fallback preview-build-only is rejected at runtime.
AUTH_SECRET=replace-with-a-long-random-string
AUTH_URL=http://localhost:3400
# Development magic links are recorded in the local database and shown at /dev/magic-links.
# Ignored for production, Vercel preview, and any database that is not on this machine.
AUTH_DEV_MAGIC_LINKS=true
# Google Workspace OAuth (managed identity). Leave empty until an OAuth client is approved.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Local database only: the first Google sign-in from this Workspace domain becomes an admin.
# A shared database never creates that admin. An existing staff record can still sign in with Google.
AUTH_GOOGLE_HD=
# Shown in the header so staff know which environment they are in.
APP_ENVIRONMENT_LABEL=development
# Private evidence uploads directory for local development. Use object storage in production.
UPLOADS_DIR=.data/uploads
# Read-only connection to the clinic website database. Submitted forms are read from there and are not copied into this platform.
# Local fixture only: postgresql://postgres:postgres@127.0.0.1:54339/clinic_genie_enquiry_test
# The database name must contain enquiry and test, the host must be local, and the port must not be 54329.
# Leave empty to keep the enquiry screens disconnected. Never point this at a production or patient database.
ENQUIRY_DATABASE_URL=
# Owner connection for clinic_genie_enquiry_staging. Setup only. Not an application credential.
# Put the real value in the gitignored .env file. Leave this example empty.
ENQUIRY_STAGING_ADMIN_URL=

# Wix Forms read for a website whose enquiry source is Wix. These are the app credentials only.
# The instance id and form id belong on that website. They are not a second client scope.
# Leave empty until the forms app is approved. Do not put the analytics app id here.
FORMS_WIX_APP_ID=
FORMS_WIX_APP_SECRET=
# Wix Forms (new) instance for a website marked Wix. Empty until that website is identified.
# These are not the old Forms and Payments app, and they do not by themselves choose the form.
FORMS_WIX_NEW_INSTANCE_AQUA=
FORMS_WIX_NEW_INSTANCE_CEDAR=
FORMS_WIX_NEW_INSTANCE_JOYFUL=
FORMS_WIX_NEW_INSTANCE_MSDC=
FORMS_WIX_NEW_INSTANCE_SBSN=
FORMS_WIX_NEW_INSTANCE_SDIC=
FORMS_WIX_NEW_INSTANCE_SUNRISE=
FORMS_WIX_NEW_INSTANCE_TAC=
FORMS_WIX_NEW_INSTANCE_FORMS_TEST=

# --- Analytics providers. Leave empty until the account owner grants access. Tokens are encrypted with ANALYTICS_TOKEN_KEY and are never sent to the browser. ---
ANALYTICS_GOOGLE_CLIENT_ID=
ANALYTICS_GOOGLE_CLIENT_SECRET=
ANALYTICS_WIX_APP_ID=
ANALYTICS_WIX_APP_SECRET=
ANALYTICS_TOKEN_KEY=
# Optional. Mobile lab scores still run without a key, on the unkeyed quota.
PAGESPEED_API_KEY=
ANALYTICS_WORKER_SECRET=
# Bearer sent by a Vercel Cron invocation. The worker accepts this or ANALYTICS_WORKER_SECRET. Leave empty locally.
CRON_SECRET=
# Off keeps the existing snapshot reports. On reads promoted provider partitions only.
ANALYTICS_LIVE_REPORTS=false
# Set to 1 only while running fixture checks. The worker then refuses every non-local provider host, so test runs cannot reach production analytics.
ANALYTICS_FIXTURE_MODE=
# Leave unset. Set to 1 only when the worker database is an approved non-production host that is not this machine.
ANALYTICS_ALLOW_REMOTE_WORKER=
# Optional base URL for the local consumer probe. Defaults to http://127.0.0.1:3400. Not a public deployment.
GENIE_WORKS_BASE_URL=
